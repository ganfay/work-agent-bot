# PostgreSQL Credentials
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_DB=bidder_db
PG_HOST=localhost
PG_PORT=5432
PG_SSLMODE=disable

# RabbitMQ Credentials (change default guest/guest in production)
RMQ_USER=guest
RMQ_PASS=guest
RMQ_HOST=localhost
RMQ_PORT=5672

# Djinni & Scraper Config
DJINNI_RSS_URL="https://djinni.co/jobs/rss/?search_type=basic-search&primary_keyword=Golang&exp_level=no_exp&exp_level=1y&employment=remote"
LOG_PATH="logs/scraper.log"
SCRAPE_INTERVAL="15m"

# AI Worker Credentials & Config
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_LOG_PATH="logs/ai_worker.log"

# Telegram Bot Config
TG_BOT_TOKEN=your_bot_token_from_botfather
TG_USER_ID=your_numerical_telegram_id
TG_LOG_PATH="logs/tg_bot.log"

# Batch Mode (make run-once) Settings
RUN_ONCE=false
AI_BATCH_IDLE_TIMEOUT=20s
TG_BATCH_IDLE_TIMEOUT=90s
TG_POLL_GRACE=15s
